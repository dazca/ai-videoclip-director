# dependencies
node_modules/

# this machine's settings (absolute paths, media roots, private rules) and anything with secrets
workbench.config.json
.mcp.json
.env
.env.*
*.env
.claude/settings.local.json

# project data: only the empty template and the synthetic demo are shared
data/*
!data/_template/
!data/demo/
data/**/.snapshots/
data/**/_src/
data/**/*.tmp
data/.demo-src/

# thumbnails are regenerated by the importers / media_add (the demo keeps its tiny synthetic ones)
**/thumbs/
!data/demo/thumbs/

# headless screenshots and reports (they can show real faces)
shots/

# anything marked private
**/private/
**/*.private.*
**/priv_*

# logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
